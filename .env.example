# Server-only n8n webhook destination. Set this in your local .env.local;
# never expose it through a NEXT_PUBLIC_* variable or browser code.
# SupportAI sends lead JSON with the lowercase keys: name, email, question, timestamp.
N8N_WEBHOOK_URL=""

# Optional. Days of visitor inactivity after which an embedded-widget conversation can no
# longer be resumed (integer 1-365, default 30). Expired conversations are detached from the
# visitor's browser session; their history is retained, not physically deleted.
# WIDGET_CONVERSATION_RETENTION_DAYS=30
